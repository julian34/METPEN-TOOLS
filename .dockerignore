# Ignore version control
.git
.gitignore

# Ignore Python cache
__pycache__
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Ignore Jupyter checkpoints
.ipynb_checkpoints

# Ignore virtual environments
venv/
env/
ENV/

# Ignore dev container files (tidak diperlukan untuk standalone Docker)
.devcontainer/

# Ignore VS Code settings
.vscode/
.skills/

# Ignore system files
.DS_Store
Thumbs.db

# Ignore large data files if any
*.csv.gz
*.zip
*.tar.gz
